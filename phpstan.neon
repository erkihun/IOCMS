includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
    excludePaths:
        - app/Support/*/stubs/*
    ignoreErrors:
        # Eloquent dynamic properties are validated by Larastan model reflection;
        # a few framework-magic accessors on the base User model are unavoidable.
        -
            identifier: property.notFound
            path: app/Http/Middleware/HandleInertiaRequests.php
    checkModelProperties: false
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
