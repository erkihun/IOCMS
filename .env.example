###############################################################################
# IOCMS environment example (LOCAL). Copy to .env and adjust.
# Staging/production overrides: see docs/deployment/*. Secrets are NEVER stored
# in source control — production secrets are secret-manager references (NFR-SE-016).
###############################################################################

APP_NAME=IOCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Localization (FR-LOC): Amharic + English end to end.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
IOCMS_DEFAULT_LOCALE=en
IOCMS_DEFAULT_CURRENCY=ETB
IOCMS_BUSINESS_TIMEZONE=Africa/Addis_Ababa
IOCMS_RESERVATION_TTL_MINUTES=30

# Marketplace master gate — OFF until governance readiness (SDD ADR-020, D-005).
IOCMS_FEATURE_MARKETPLACE=false

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Authoritative transactional store is MySQL 8 (LLD §3.1). Local dev may use the
# bundled SQLite file; the testing connection is in-memory SQLite (phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iocms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Horizon (production worker supervisor — Linux; ext-pcntl/posix, see D-012).
HORIZON_PREFIX=iocms_horizon

# Search projection (rebuildable — ADR-014). Default DB/collection driver; switch
# to meilisearch when the service is configured.
SCOUT_DRIVER=database
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@iocms.local"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible private object storage (ADR-013). Private by default; signed URLs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

###############################################################################
# External provider ports (ports + fakes; real adapters gated on config — D-006/007)
###############################################################################
# Payment: online provider disabled until a licensed adapter + credentials exist.
IOCMS_PAYMENT_ONLINE_ENABLED=false
IOCMS_PAYMENT_COD_ENABLED=true
IOCMS_PAYMENT_BANK_TRANSFER_ENABLED=true
IOCMS_PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Courier / messaging / map / OIDC / malware-scan ports (fakes by default).
IOCMS_COURIER_DRIVER=fake
IOCMS_SMS_DRIVER=log
IOCMS_TELEGRAM_DRIVER=log
IOCMS_MAP_DRIVER=fake
IOCMS_OIDC_ENABLED=false
IOCMS_MALWARE_SCAN_DRIVER=fake

VITE_APP_NAME="${APP_NAME}"
