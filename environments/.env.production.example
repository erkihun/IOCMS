# IOCMS PRODUCTION — debug OFF, HTTPS enforced, secrets via secret manager only.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://iocms.example
DB_CONNECTION=mysql
DB_HOST=__secret_manager__
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SCOUT_DRIVER=meilisearch
FILESYSTEM_DISK=s3
LOG_LEVEL=warning
# Marketplace remains OFF until governance readiness (SDD ADR-020).
IOCMS_FEATURE_MARKETPLACE=false
# Provider adapters enabled only with licensed credentials from the secret manager.
IOCMS_PAYMENT_ONLINE_ENABLED=false
