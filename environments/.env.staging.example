# IOCMS STAGING — production-like; separate credentials; debug OFF.
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.iocms.example
DB_CONNECTION=mysql
DB_HOST=__secret_manager__
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SCOUT_DRIVER=meilisearch
FILESYSTEM_DISK=s3
IOCMS_FEATURE_MARKETPLACE=false
# All secrets are secret-manager references, never literal values (NFR-SE-016).
