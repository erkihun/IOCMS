# IOCMS TESTING environment (in-memory SQLite, sync queue, array cache).
# The actual test env values live in phpunit.xml <php> block.
APP_ENV=testing
APP_DEBUG=true
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SCOUT_DRIVER=collection
MAIL_MAILER=array
IOCMS_FEATURE_MARKETPLACE=false
